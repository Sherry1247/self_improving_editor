# HTCondor submit file for Grounding DINO MVP on UW-Madison CHTC
#
# Run all samples:
#   condor_submit submit.sub
#
# Run one sample:
#   condor_submit -a "SAMPLE_ID=sample_001" submit.sub

universe        = vanilla
executable      = submit.sh
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = data, config, src, run_experiment.py, requirements.txt

request_gpus    = 1
request_cpus    = 4
request_memory  = 16GB
request_disk    = 15GB

log             = logs/condor.log
output          = logs/job_$(Cluster).$(Process).out
error           = logs/job_$(Cluster).$(Process).err

# One job per sample; set SAMPLE_ID=all by using empty to process everything
queue SAMPLE_ID in (sample_001, sample_002)

environment = "SAMPLE_ID=$(SAMPLE_ID) USE_MOCK=0"

# Generic CHTC GPU job. Pick what to run with command-line assignments, e.g.
#   condor_submit chtc/job.sub MODE=check  RUN=check1 LIST=jobs/one.txt
#   condor_submit chtc/job.sub MODE=loop   RUN=smoke  LIST=jobs/smoke.txt  EXTRA="--targets snow --save-candidates"
#   condor_submit chtc/job.sub MODE=loop   RUN=ip2p   LIST=jobs/samples.txt
#   condor_submit chtc/job.sub MODE=loop   RUN=comp   LIST=jobs/samples.txt EDITOR=compositing
#   condor_submit chtc/job.sub MODE=auroc  RUN=e1     LIST=jobs/one.txt
#   condor_submit chtc/job.sub MODE=loop   RUN=qwen   LIST=jobs/samples.txt EDITOR=qwen_edit GPUMEM=75000M DISK=120GB
#   bash chtc/pack_rescore.sh ip2p comp && \
#   condor_submit chtc/job.sub MODE=rescore RUN=rescored LIST=jobs/one.txt EXTRA_IN=,chtc/rescore_in.tar.gz
# Reward baselines and VLM stability (scores only, no editing; scoring sets are built on the submit node, CPU only):
#   python experiments/build_scoring_set.py --name rw_violations --violations runs/e1v2 && bash chtc/pack_rewardset.sh rw_violations
#   condor_submit chtc/job.sub MODE=viescore   RUN=rw_vio_vie  LIST=jobs/one.txt EXTRA_IN=,chtc/rewardset_in.tar.gz GPUMEM=24000M
#   condor_submit chtc/job.sub MODE=viescore   RUN=rw_vio_vie2 LIST=jobs/one.txt EXTRA_IN=,chtc/rewardset_in.tar.gz VLM_KIND=vlm2
#   condor_submit chtc/job.sub MODE=editreward RUN=rw_vio_er   LIST=jobs/one.txt EXTRA_IN=,chtc/rewardset_in.tar.gz GPUMEM=24000M
#   bash chtc/pack_rescore.sh comp_v2 qwen && condor_submit chtc/job.sub MODE=vlmvar RUN=vlmvar LIST=jobs/one.txt EXTRA_IN=,chtc/rescore_in.tar.gz
#   (same with VLM_KIND=vlm2 RUN=vlmvar2 for the second VLM; EXTRA="--limit 3" first as a smoke test)
# Violation suite v3 (shift_side controls, shared inpainting plate; docs/results/2026-11-05-reward-baselines-violation-suite.md):
#   condor_submit chtc/job.sub MODE=auroc RUN=e1v3 LIST=jobs/one.txt       # critics on the new suite, writes scores_by_sample.json
#   (collect, then on the submit node)
#   python experiments/build_scoring_set.py --name rw_v3 --violations runs/e1v3 && bash chtc/pack_rewardset.sh rw_v3
#   condor_submit chtc/job.sub MODE=editreward RUN=rw_v3_er  LIST=jobs/one.txt EXTRA_IN=,chtc/rewardset_in.tar.gz GPUMEM=24000M
#   condor_submit chtc/job.sub MODE=viescore   RUN=rw_v3_vie LIST=jobs/one.txt EXTRA_IN=,chtc/rewardset_in.tar.gz GPUMEM=24000M
#   python experiments/violation_compare.py --critics runs/e1v3/scores_by_sample.json --scoreset runs/rw_v3 \
#       --scores runs/rw_v3_er/scores_editreward.jsonl runs/rw_v3_vie/scores_viescore_vlm.jsonl --name vio_compare
# Violation suite v4 (protected ground strip, buried, smear_ctrl, shadow lift; criteria frozen in docs/specs/2026-11-06-contact-detector-freeze.md):
#   condor_submit chtc/job.sub MODE=auroc       RUN=e1v4   LIST=jobs/one.txt GPUMEM=24000M
#   condor_submit chtc/job.sub MODE=contactdiag RUN=cdiag4 LIST=jobs/one.txt GPUMEM=24000M
#   (collect both, then) python experiments/build_scoring_set.py --name rw_v4 --violations runs/e1v4 && bash chtc/pack_rewardset.sh rw_v4
#   condor_submit chtc/job.sub MODE=editreward RUN=rw_v4_er LIST=jobs/one.txt EXTRA_IN=,chtc/rewardset_in.tar.gz GPUMEM=24000M
#   python experiments/violation_compare.py --critics runs/e1v4/scores_by_sample.json --scoreset runs/rw_v4 --scores runs/rw_v4_er/scores_editreward.jsonl --name vio4
#   python experiments/violation_compare.py --critics runs/cdiag4/scores_by_sample.json --name cdiag4_cmp --combine-ref ""   (add --split dev / test to split)
# One job per line of LIST (a sample id). Results come back as results/result_<RUN>_<sample>.tar.gz
# Defaults use $(VAR:default) so that command-line assignments win
# (a plain "RUN = smoke" line in this file would override RUN=... given to condor_submit).

universe                = container
container_image         = docker://pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
executable              = chtc/run.sh
arguments               = $(MODE:loop) $(RUN:smoke) $(sample) $(EXTRA:)
environment             = "EDITOR=$(EDITOR:ip2p) VLM_KIND=$(VLM_KIND:vlm)"

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = chtc/payload.tar.gz$(EXTRA_IN:)
transfer_output_files   = result_$(RUN:smoke)_$(sample).tar.gz
transfer_output_remaps  = "result_$(RUN:smoke)_$(sample).tar.gz = results/result_$(RUN:smoke)_$(sample).tar.gz"

request_gpus            = 1
gpus_minimum_memory     = $(GPUMEM:40000M)
+WantGPULab             = true
+GPUJobLength           = "short"
request_cpus            = 4
request_memory          = 32GB
request_disk            = $(DISK:60GB)

log    = chtc/logs/$(RUN:smoke).log
output = chtc/logs/$(RUN:smoke)_$(sample).out
error  = chtc/logs/$(RUN:smoke)_$(sample).err

queue sample from $(LIST:jobs/smoke.txt)

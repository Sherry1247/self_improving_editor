# HTCondor submit file for batch closed-loop editing on CHTC.
#
# Usage (from repo root):
#   mkdir -p logs
#   condor_submit chtc/submit.sub
#
# Scale to thousands of jobs by expanding jobs/jobs.csv.

universe        = vanilla
executable      = chtc/run.sh
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = jobs/jobs.csv, src, experiments, data/images/original, data/labels.csv, src/configs/default.yaml, src/requirements.txt, main.py

# Request GPU resources (adjust for your CHTC pool)
request_gpus    = 1
request_cpus    = 4
request_memory  = 16GB
request_disk    = 20GB

log             = logs/condor.log
output          = logs/job_$(Cluster).$(Process).out
error           = logs/job_$(Cluster).$(Process).err

queue job_id, filename, object, action, background from jobs/jobs.csv

environment = "JOB_ID=$(job_id) FILENAME=$(filename) OBJECT=$(object) ACTION=$(action) BACKGROUND=$(background)"

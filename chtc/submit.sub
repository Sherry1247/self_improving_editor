# One job per sample (15 jobs). From the repo root:
#   mkdir -p chtc/logs && condor_submit chtc/submit.sub
# Override the run name / editor:  condor_submit chtc/submit.sub RUN=comp EXTRA="--set loop.editor=compositing"
RUN   = ip2p_chtc
EXTRA =

universe              = container
container_image       = docker://pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
executable            = chtc/run.sh
arguments             = $(sample) $(RUN) $(EXTRA)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files  = src, configs, experiments, validation, requirements.txt, data/labels.csv, data/images/original
transfer_output_files = result_$(RUN)_$(sample).tar.gz

request_gpus          = 1
require_gpus          = (GlobalMemoryMb >= 20000)
+WantGPULab           = true
+GPUJobLength         = "short"
request_cpus          = 4
request_memory        = 32GB
request_disk          = 60GB

log    = chtc/logs/$(RUN).log
output = chtc/logs/$(RUN)_$(sample).out
error  = chtc/logs/$(RUN)_$(sample).err

queue sample from jobs/samples.txt
